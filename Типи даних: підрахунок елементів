# 1. Створюємо вихідний масив з різними типами даних
source_array = [
    True, 'hello', 5, 12, -200, False, False, 'word',
    15.5, None, 'Python', 100, True, [1, 2], ('a', 'b'),
    {'key': 'value'}, 42, 0.0, ''
]

# 2. Створюємо словник-лічильник
types_counter = {
    'int': 0,
    'str': 0,
    'bool': 0,
    'float': 0,
    'NoneType': 0,
    'list': 0,
    'tuple': 0,
    'dict': 0
}

# 3. Проходимо по масиву і рахуємо елементи
for item in source_array:
  type_name = type(item).__name__ # Отримуємо ім'я типу як рядок (напр., 'int')
  if type_name in types_counter:
    types_counter[type_name] += 1

print("--- Частина 2.1: Підрахунок з готовим словником ---")
print(f"Вихідний масив: {source_array}")
print(f"Результат підрахунку: {types_counter}")
print("-" * 20)
