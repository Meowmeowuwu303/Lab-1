def inc_by_value(n: int) -> int:
  """
  Приймає число, повертає нове число, збільшене на 1.
  Оригінальна змінна не змінюється.
  """
  return n + 1

# --- Приклад виклику ---
a = 5
b = inc_by_value(a)

print("--- Частина 1.1: Передача за значенням ---")
print(f"Початкове значення 'a': {a}") # a залишиться 5
print(f"Нове значення 'b': {b}")     # b буде 6
print("-" * 20)
