# 4. Видаляємо ключі та додаємо їх динамічно
dynamic_types_counter = {} # Починаємо з порожнього словника

for item in source_array:
  type_name = type(item).__name__
  # Використовуємо метод .get() для безпечного доступу та інкременту.
  # Якщо ключа немає, .get(type_name, 0) поверне 0.
  dynamic_types_counter[type_name] = dynamic_types_counter.get(type_name, 0) + 1


print("--- Частина 2.2: Підрахунок з динамічним додаванням ключів ---")
print(f"Вихідний масив: {source_array}")
print(f"Результат динамічного підрахунку: {dynamic_types_counter}")
print("-" * 20)
