# У Python для імітації об'єкта { n: 5 } ідеально підходить словник.
def inc_by_reference(data: dict):
  """
  Приймає словник та збільшує значення за ключем 'n' на 1.
  Змінює вихідний об'єкт.
  """
  if 'n' in data and isinstance(data['n'], (int, float)):
    data['n'] += 1

# --- Приклад виклику ---
obj = {'n': 5}
print("--- Частина 1.2: Передача за посиланням ---")
print(f"Об'єкт до виклику функції: {obj}")
inc_by_reference(obj) # Функція нічого не повертає, вона змінює obj
print(f"Об'єкт після виклику функції: {obj}") # obj тепер {'n': 6}
print("-" * 20)
